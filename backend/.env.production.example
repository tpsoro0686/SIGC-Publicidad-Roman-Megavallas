# Plantilla del .env para el servidor de PRODUCCION.
# Copia este archivo como ".env" en el servidor y completa lo que dice CAMBIAR.
# Nunca lo subas a git con valores reales.

APP_NAME="SIGC Publicidad Román"
APP_ENV=production
APP_KEY=                      # CAMBIAR: se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.romanmegavallas.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigc
DB_USERNAME=sigc              # CAMBIAR: usuario propio, NO root
DB_PASSWORD=                  # CAMBIAR: contraseña larga

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Frontend permitido (el SIGC y el portal viven en este mismo sitio)
CORS_ALLOWED_ORIGINS=https://sigc.romanmegavallas.com

# El servidor usa Nginx como proxy: necesario para que el límite de intentos vea la IP real
TRUSTED_PROXIES=*

# Sesiones: 7 días (en minutos)
SANCTUM_EXPIRATION=10080

# Contraseña del admin inicial (solo se usa la primera vez con db:seed)
SEED_ADMIN_PASSWORD=          # CAMBIAR: NUNCA "1234"

# Correo (Brevo). Remitente debe ser de un dominio verificado.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=                # CAMBIAR
MAIL_PASSWORD=                # CAMBIAR
MAIL_FROM_ADDRESS=notificaciones@romanmegavallas.com
MAIL_FROM_NAME="Publicidad Román Megavallas"

# Portal
PORTAL_DIAS_APARTADO=3
PORTAL_MAX_APARTADAS=10

# Pagos en línea: apagados hasta elegir pasarela
PAGOS_HABILITADOS=false
PAGOS_PASARELA=simulado
PAGOS_MONEDA=USD
PAGOS_PORCENTAJE_ADELANTO=30
PAGOS_URL_RETORNO=https://sigc.romanmegavallas.com/portal/index.html
